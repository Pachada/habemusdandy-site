---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProductFrame from '../components/ProductFrame.astro'
import Cta from '../components/Cta.astro'
import { appSignupUrl } from '../config/site'

const title = 'Agenda, expediente y recordatorios para tu negocio'
const description =
  'Panel, agenda, expediente, formularios de ingreso, recordatorios por email y SMS, reportes, roles e integraciones: el flujo completo de la visita en un solo software.'

const groups = [
  {
    id: 'panel',
    label: 'Panel principal',
    title: 'Hoy, sin buscar en cinco lugares.',
    intro: 'Citas de hoy, estados y acciones rápidas en la vista que abre el equipo.',
    items: [
      { title: 'Citas de hoy', line: 'Lo próximo primero, sin buscar en varios lugares.' },
      { title: 'Estados', line: 'Confirmada, en curso o lista para atender.' },
      { title: 'Acciones rápidas', line: 'Nueva cita e ingresos pendientes a la mano.' },
    ],
    frame: 'panel' as const,
    activeNav: 'Panel principal',
  },
  {
    id: 'agenda',
    label: 'Agenda',
    title: 'Horario, servicios y citas, en una sola semana.',
    intro: 'Horario, servicios y disponibilidad para que reservar no dependa del chat.',
    items: [
      { title: 'Citas', line: 'Vista semanal clara para el día a día.' },
      { title: 'Horario', line: 'Disponibilidad, excepciones y zona horaria.' },
      { title: 'Servicios', line: 'Duración, precio y color definidos.' },
    ],
    frame: 'agenda' as const,
    activeNav: 'Citas',
  },
  {
    id: 'clientes',
    label: 'Clientes',
    title: 'Cada cliente, con su historia.',
    intro: 'El expediente de cada cliente: datos, visitas y notas anteriores juntos cuando llega el siguiente encuentro.',
    items: [
      { title: 'Fichas', line: 'Datos y visitas en un solo lugar.' },
      { title: 'Historial', line: 'Lo anterior viaja con la ficha.' },
      { title: 'Perfil', line: 'Información del cliente al abrir la ficha.' },
      { title: 'Visitas', line: 'Sesiones recientes junto al contexto.' },
    ],
    frame: 'client' as const,
    activeNav: 'Clientes',
  },
  {
    id: 'clinica',
    label: 'Seguimiento',
    title: 'Notas y seguimiento, sesión tras sesión.',
    intro: 'Atiendes con el plan anterior a la vista y dejas listo el siguiente paso.',
    items: [
      { title: 'Notas', line: 'Registro por sesión, sin PDF perdido.' },
      { title: 'Historial', line: 'Continuidad entre visitas.' },
      { title: 'Seguimiento', line: 'Objetivo y plan visibles.' },
      { title: 'Contexto', line: 'Ficha y nota juntas al atender.' },
    ],
    frame: 'note' as const,
    activeNav: 'Citas',
  },
  {
    id: 'formularios',
    label: 'Formularios',
    title: 'Ingreso, consentimiento y firma, antes de la cita.',
    intro: 'Prepara preguntas, consentimiento y firma antes de que la persona llegue a la sesión.',
    note: 'En Equipos y Empresas.',
    items: [
      { title: 'Diseñador de ingreso', line: 'Campos y preguntas a tu medida.' },
      { title: 'Marca', line: 'El formulario sigue el lenguaje de tu negocio.' },
      { title: 'Consentimiento', line: 'Aceptación y firma en el mismo flujo.' },
      { title: 'Enlace ligado', line: 'El ingreso llega antes de la cita.' },
    ],
    frame: 'intake' as const,
    activeNav: 'Formularios',
  },
  {
    id: 'equipo',
    label: 'Administración',
    title: 'Cada persona ve lo que necesita.',
    intro: 'Roles, configuración y la identidad de tu negocio en el mismo espacio de trabajo.',
    items: [
      { title: 'Usuarios', line: 'Owner, Manager y Staff según su responsabilidad.' },
      { title: 'Roles', line: 'Acceso según la persona, no para todos igual.' },
      { title: 'Branding', line: 'Personalización básica de tu negocio.' },
      { title: 'Configuración', line: 'Preferencias del espacio de trabajo.' },
    ],
    frame: 'team' as const,
    activeNav: 'Administración',
    note: 'En Equipos y Empresas.',
  },
  {
    id: 'integraciones',
    label: 'Integraciones',
    title: 'Se conecta con lo que ya usas.',
    intro: 'Las citas de tu negocio aparecen en los calendarios que el equipo ya abre cada día.',
    items: [
      { title: 'Google Calendar', line: 'Las citas aparecen en Google Calendar.' },
      { title: 'Apple Calendar', line: 'Consulta las mismas citas desde Apple Calendar.' },
    ],
    frame: 'integrations' as const,
    activeNav: 'Integraciones',
    note: 'En Equipos y Empresas.',
  },
  {
    id: 'automatizacion',
    label: 'Automatizaciones',
    title: 'El recordatorio sale solo.',
    intro: 'Email y SMS alrededor de la cita, configurados para tu negocio.',
    items: [
      {
        title: 'Cuándo se envía',
        line: 'Minutos, horas o días antes del inicio o después del fin de la cita.',
      },
      { title: 'Email y SMS', line: 'Recordatorios y seguimiento por los dos canales.' },
      {
        title: 'A quién',
        line: 'Cliente, profesional asignado u organización, según el flujo.',
      },
      { title: 'Pausar el flujo', line: 'Detén una automatización sin borrar la configuración.' },
    ],
    frame: 'workflows' as const,
    activeNav: 'Automatizaciones',
    note: 'En Equipos y Empresas.',
  },
  {
    id: 'reportes',
    label: 'Reportes',
    title: 'Paneles e insights para tu organización.',
    intro: 'Citas, clientes, ocupación y servicios en paneles, más insights a partir de la actividad.',
    items: [
      {
        title: 'Paneles y gráficos',
        line: 'Citas, clientes, ocupación y servicios en un solo lugar.',
      },
      {
        title: 'Vista de un vistazo',
        line: 'Lo importante de tu organización, sin salir del panel.',
      },
      {
        title: 'Insights con IA',
        line: 'Análisis y recomendaciones a partir de la actividad de tu negocio.',
      },
    ],
    frame: 'insights' as const,
    activeNav: 'Reportes',
    frameLabel: 'Reportes',
    note: 'En Equipos y Empresas.',
  },
]
---

<BaseLayout title={title} description={description}>
  <section class="section hero">
    <div class="container hero__inner reveal">
      <p class="section-label">Producto</p>
      <h1>Agenda, clientes y seguimiento, en el mismo flujo.</h1>
      <p class="section-lead">
        Panel, reservas, fichas y notas comparten el mismo contexto: cada módulo continúa donde terminó el anterior.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={appSignupUrl}>Comenzar gratis</a>
        <a class="btn btn--ghost" href="/precios">Ver precios</a>
      </div>
    </div>
    <div class="container hero__visual reveal" data-reveal="scale" data-ambient>
      <div class="ambient-float ambient-float--slow">
        <ProductFrame variant="agenda" activeNav="Citas" label="Agenda semanal" />
      </div>
    </div>
  </section>

  {
    groups.map((group, index) => (
      <section class:list={['section', 'product-section', index % 2 === 1 && 'product-section--band']} id={group.id}>
        <div class:list={['container', 'group', index % 2 === 1 && 'group--reverse']}>
          <div class="group__copy reveal">
            <div class="group__label">
              <span class="group__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <p class="section-label">{group.label}</p>
            </div>
            <h2 class="section-title">{group.title}</h2>
            <p class="section-lead">{group.intro}</p>
            <ul>
              {group.items.map((item) => (
                <li>
                  <strong>{item.title}</strong>
                  <span>{item.line}</span>
                </li>
              ))}
            </ul>
            {'note' in group && group.note && <p class="plan-note">{group.note}</p>}
          </div>
          <div class="group__visual reveal">
            <ProductFrame
              variant={group.frame}
              activeNav={group.activeNav}
              label={'frameLabel' in group && group.frameLabel ? group.frameLabel : group.label}
              compact={group.frame !== 'agenda' && group.frame !== 'client' && group.frame !== 'note'}
            />
          </div>
        </div>
      </section>
    ))
  }

  <Cta secondaryHref="/precios" secondaryLabel="Ver precios" />
</BaseLayout>

<style>
  .hero__inner {
    max-width: 48rem;
  }

  .hero h1 {
    margin: 0;
    max-width: 46rem;
    font-size: clamp(2.55rem, 6vw, 4.8rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.02;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .hero__visual {
    width: min(100%, 62rem);
    max-width: 100%;
    min-width: 0;
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
  }

  .group {
    display: grid;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }

  .group__label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: var(--space-3);
  }

  .group__label .section-label {
    margin-bottom: 0;
  }

  .group__index {
    display: inline-grid;
    place-items: center;
    width: fit-content;
    min-width: 2.15rem;
    height: 1.7rem;
    padding-inline: 0.55rem;
    border-radius: 999px;
    background: var(--color-frame);
    color: var(--color-ink-mid);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .product-section--band {
    background: var(--color-frame);
  }

  .product-section--band .group__index {
    background: var(--color-surface);
  }

  .group ul {
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .group li {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-3);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    box-shadow: var(--shadow-card);
  }

  .group li::before {
    content: '';
    position: absolute;
    left: 0.4rem;
    top: calc(0.85rem + 0.5lh);
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--color-ink);
    transform: translateY(-50%);
  }

  .group li > * {
    min-width: 0;
  }

  .group strong {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .group span {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .group__visual {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .group {
      grid-template-columns: 0.95fr 1.05fr;
    }

    .group--reverse .group__copy {
      order: 2;
    }
  }

  @media (max-width: 600px) {
    .group li { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
