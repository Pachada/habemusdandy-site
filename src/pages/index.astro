  .pain-follow li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.8rem;
    box-shadow: var(--shadow-card);
  }

  :global(.js) .problem-card:not(.is-visible) .pain-chat__bubble,
  :global(.js) .problem-card:not(.is-visible) .pain-chat__waiting,
  :global(.js) .problem-card:not(.is-visible) .pain-ficha dl,
  :global(.js) .problem-card:not(.is-visible) .pain-ficha__visits li,
  :global(.js) .problem-card:not(.is-visible) .pain-follow li {
    opacity: 0;
    transform: translateY(0.4rem);
  }

  .problem-card.is-visible .pain-chat__bubble--in {
    animation: scene-in var(--duration-enter) var(--ease-out) 80ms both;
  }

  .problem-card.is-visible .pain-chat__bubble--out {
    animation: scene-in var(--duration-enter) var(--ease-out) 240ms both;
  }

  .problem-card.is-visible .pain-chat__waiting {
    animation: scene-in var(--duration-enter) var(--ease-out) 460ms both;
  }

  .problem-section.is-ambient .pain-chat__waiting {
    animation:
      scene-in var(--duration-enter) var(--ease-out) 460ms both,
      wait-breathe 3.8s ease-in-out 1.1s infinite;
  }

  .problem-card.is-visible .pain-ficha dl {
    animation: scene-in var(--duration-enter) var(--ease-out) 90ms both;
  }

  .problem-card.is-visible .pain-ficha__visits li:nth-child(1) {
    animation: scene-in var(--duration-enter) var(--ease-out) 180ms both;
  }

  .problem-card.is-visible .pain-ficha__visits li:nth-child(2) {
    animation: scene-in var(--duration-enter) var(--ease-out) 270ms both;
  }

  .problem-card.is-visible .pain-follow li:nth-child(1) {
    animation: scene-in var(--duration-enter) var(--ease-out) 120ms both;
  }

  .problem-card.is-visible .pain-follow li:nth-child(2) {
    animation: scene-in var(--duration-enter) var(--ease-out) 220ms both;
  }

  @keyframes scene-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes wait-breathe {
    0%,
    100% { opacity: 0.58; }
    50% { opacity: 1; }
  }

  .problem-card h3,
