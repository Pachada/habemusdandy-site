  .pain-ficha dd {
    margin: 0;
    color: var(--color-muted);
    font-weight: 500;
  }

  .pain-ficha dd.is-empty,
  .pain-ficha__visits .is-empty span:last-child {
    color: color-mix(in srgb, var(--color-muted) 72%, transparent);
    font-style: italic;
    font-weight: 400;
  }

  .pain-ficha__visits {
    margin: 0;
    padding: 0;
