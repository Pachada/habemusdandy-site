      display: none;
    }

    .ui-appt__compact {
      display: inline;
    }

    .ui-week {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ui-day:nth-child(n + 3) {
      display: none;
    }

    .ui-toolbar__meta {
      display: none;
    }
