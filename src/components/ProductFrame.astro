    animation: sign-ready 520ms ease-out 560ms both;
  }

  .product-frame.is-inview[data-product-frame='hours'] .ui-hours__block,
  .product-frame.is-inview[data-product-frame='team'] .ui-team li,
  .product-frame.is-inview[data-product-frame='services'] .ui-services li {
    animation: micro-scene-in var(--duration-enter) var(--ease-out) both;
  }

  .product-frame.is-inview[data-product-frame='hours'] .ui-hours__block:nth-child(2),
  .product-frame.is-inview[data-product-frame='team'] .ui-team li:nth-child(2),
