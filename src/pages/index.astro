---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProductFrame from '../components/ProductFrame.astro'
import ClinicJourney from '../components/ClinicJourney.astro'
import BillingToggle from '../components/BillingToggle.astro'
import Faq from '../components/Faq.astro'
import Cta from '../components/Cta.astro'
import { appSignupUrl, equiposPricing, faqItems, formatMxn, salesContactUrl } from '../config/site'

const monthlyList = formatMxn(equiposPricing.monthlyList)
const monthlyPromo = formatMxn(equiposPricing.monthlyPromo)
const annualList = formatMxn(equiposPricing.annualListPerMonth)
const annualPromo = formatMxn(equiposPricing.annualPromoPerMonth)
const annualBilled = formatMxn(equiposPricing.annualBilled)

const title = 'Tu clínica ordenada, de la cita al seguimiento'
const description =
  'Agenda, formularios, fichas y notas clínicas en un solo flujo. Para clínicas que quieren dejar de operar desde el chat.'

const setupSteps = [
  {
    n: '01',
    title: 'Define horario y servicios',
    line: 'Cuándo atiendes y qué ofreces',
    frame: 'hours' as const,
    frameProps: { compact: true, micro: 'availability', activeNav: 'Horario', label: 'Disponibilidad' },
  },
  {
    n: '02',
    title: 'Recibe la reserva',
    line: 'El hueco queda en la agenda, no en el chat',
    frame: 'agenda' as const,
    frameProps: { crop: true, compact: true, micro: 'reservation', activeNav: 'Citas', label: 'Reserva confirmada' },
  },
  {
    n: '03',
    title: 'Atiende con la ficha lista',
    line: 'Datos y visitas anteriores al abrir',
    frame: 'client' as const,
    frameProps: { compact: true, micro: 'record', activeNav: 'Clientes', label: 'Ficha preparada' },
  },
] as const

const capabilityTiles = [
  {
    title: 'Servicios',
    copy: 'Duración, precio y color de cada atención, listos para la agenda.',
    frame: 'services' as const,
    frameProps: { compact: true, micro: 'services', activeNav: 'Servicios', label: 'Servicios de la clínica' },
  },
  {
    title: 'Formularios',
    copy: 'Ingreso con tu marca, consentimiento y firma en el mismo flujo.',
    frame: 'intake' as const,
    frameProps: { compact: true, micro: 'forms', activeNav: 'Formularios', label: 'Formulario de ingreso' },
  },
  {
    title: 'Horario',
    copy: 'Disponibilidad semanal, excepciones de fecha y zona horaria.',
    frame: 'hours' as const,
    frameProps: { compact: true, micro: 'hours', activeNav: 'Horario', label: 'Horario de la clínica' },
  },
  {
    title: 'Equipo y roles',
    copy: 'Acceso según el rol: Owner, Manager o Staff, sin compartirlo todo.',
    frame: 'team' as const,
    frameProps: { compact: true, micro: 'team', activeNav: 'Administración', label: 'Roles del equipo' },
  },
] as const
---

<BaseLayout title={title} description={description}>
  <section class="hero section">
    <div class="container hero__grid">
      <div class="hero__copy reveal">
        <p class="hero__eyebrow"><span class="status-dot status-dot--ok"></span> Para clínicas</p>
        <h1>Tu clínica ordenada, <span>de la cita al seguimiento.</span></h1>
        <p class="hero__sub">
          Agenda, formularios, fichas y notas clínicas en un solo flujo. Menos mensajes
          pendientes; más tiempo para atender.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={appSignupUrl}>Comenzar gratis</a>
          <a class="btn btn--ghost" href="#como-funciona">Ver cómo funciona</a>
        </div>
        <p class="hero__trust"><span>Plan gratuito</span><span>Configuración en minutos</span></p>
      </div>
      <div class="hero__visual reveal" data-reveal="scale" data-ambient>
        <div class="hero__halo" aria-hidden="true"></div>
        <div class="hero__stage ambient-float ambient-float--slow">
          <ProductFrame variant="agenda" crop activeNav="Citas" label="Agenda semanal" />
        </div>
        <div class="signal-card signal-card--intake" aria-hidden="true">
          <span class="signal-card__icon">✓</span>
          <span><strong>Ingreso completo</strong><small>Ana Rojas · hace 2 min</small></span>
        </div>
        <div class="signal-card signal-card--note" aria-hidden="true">
          <span class="status-dot status-dot--brand"></span>
          <span><strong>Nota lista</strong><small>Sesión anterior vinculada</small></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section problem-section" data-ambient>
    <div class="container">
      <div class="reveal">
        <p class="section-label">Problema</p>
        <h2 class="section-title">Hoy la clínica se arma en el chat.</h2>
      </div>
      <div class="problem-cases">
        <article class="problem-card problem-card--lead reveal">
          <div class="problem-card__scene" aria-hidden="true">
            <div class="pain-chat">
              <p class="pain-chat__meta">Chat · Interesado</p>
              <p class="pain-chat__bubble pain-chat__bubble--in">¿Tienes el jueves a las 5?</p>
              <p class="pain-chat__bubble pain-chat__bubble--out">Deja checo y te aviso</p>
              <p class="pain-chat__waiting">Sin respuesta · 2 h</p>
            </div>
          </div>
          <div class="problem-card__copy">
            <h3>Dijiste que revisabas y no contestaste</h3>
            <p>El interesado pregunta si hay hueco. Tú ibas a mirar el horario. El mensaje se quedó visto.</p>
          </div>
        </article>
        <article class="problem-card reveal">
          <div class="problem-card__scene" aria-hidden="true">
            <div class="pain-ficha">
              <div class="pain-ficha__head">
                <strong>Sofía P.</strong>
                <span>Ficha</span>
              </div>
              <dl>
                <div><dt>Teléfono</dt><dd>· · ·</dd></div>
                <div><dt>Última visita</dt><dd class="is-empty">Sin historial</dd></div>
              </dl>
              <ul class="pain-ficha__visits">
                <li class="is-empty"><span>Visitas</span><span>Sin registros</span></li>
                <li class="is-empty"><span>Nota previa</span><span>No disponible</span></li>
              </ul>
            </div>
          </div>
          <div class="problem-card__copy">
            <h3>Cada visita empieza de cero</h3>
            <p>Lo de la sesión pasada no está en la ficha. Vuelves a preguntar lo que ya sabías.</p>
          </div>
        </article>
        <article class="problem-card reveal">
          <div class="problem-card__scene" aria-hidden="true">
            <div class="pain-follow">
              <div class="pain-follow__bar">
                <span class="status-dot"></span>
                Sesión 6 · finalizada
              </div>
              <ul>
                <li><span class="status-dot status-dot--warn"></span> Sin próxima</li>
                <li><span class="status-dot status-dot--warn"></span> Plan no registrado</li>
              </ul>
            </div>
          </div>
          <div class="problem-card__copy">
            <h3>La sesión termina y el hilo se corta</h3>
            <p>No hay próxima cita, ni plan a la vista, ni recordatorio. El seguimiento vive en la cabeza.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <div class="story-bridge story-bridge--warm" aria-label="Del problema al flujo">
    <div class="container story-bridge__inner reveal">
      <span class="story-bridge__line" aria-hidden="true"></span>
      <p><strong>El chat no es un sistema.</strong> El siguiente paso es un horario real, una reserva en la agenda y la ficha lista al atender.</p>
    </div>
  </div>

  <section class="section setup-section" id="como-funciona">
    <div class="container">
      <div class="setup-intro reveal">
        <p class="section-label">Cómo funciona</p>
        <h2 class="section-title">Empezar no debería tomar una semana.</h2>
        <p class="section-lead">
          Horario, servicios y la primera cita. El resto del flujo ya está en el mismo sitio.
        </p>
        <div class="setup-intro__actions">
          <a class="btn btn--primary" href={appSignupUrl}>Comenzar gratis</a>
          <a class="btn btn--ghost" href="#recorrido">Ver el flujo de una visita</a>
        </div>
      </div>
      <ol class="setup-flow" data-ambient>
        {
          setupSteps.map((step, index) => (
            <li class="setup-step reveal" data-stagger={String(index * 90)}>
              <span class="setup-step__n"><span>{step.n}</span></span>
              <div class="setup-step__frame ambient-float">
                <ProductFrame variant={step.frame} {...step.frameProps} />
              </div>
              <div class="setup-step__copy">
                <h3>{step.title}</h3>
                <p>{step.line}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="story-bridge" aria-label="Del setup a las capacidades">
    <div class="container story-bridge__inner reveal">
      <span class="story-bridge__line" aria-hidden="true"></span>
      <p><strong>La primera cita no basta.</strong> Servicios, formularios, horario y roles son lo que sostiene el resto del día.</p>
    </div>
  </div>

  <section class="section section--tight capability-section">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Más que una agenda</p>
        <h2 class="section-title">La operación alrededor de la visita.</h2>
        <p class="section-lead">Servicios, formularios, horario y roles. Cada pieza con su lugar, sin otra herramienta.</p>
      </div>
      <div class="capability-bento" aria-label="Capacidades operativas de la clínica" data-ambient>
        <article class="capability-bento__panel reveal" data-stagger="0">
          <div class="capability-bento__visual ambient-float ambient-float--slow">
            <ProductFrame variant="panel" compact micro="panel" activeNav="Panel principal" label="Panel principal" />
          </div>
          <div class="capability-bento__copy">
            <p class="capability-bento__eyebrow">Panel principal</p>
            <h3>Hoy, sin buscar en cinco lugares.</h3>
            <p>Citas de hoy, estados y acciones rápidas en la vista que abre el equipo.</p>
          </div>
        </article>
        <div class="capability-bento__tiles">
          {
            capabilityTiles.map((tile, index) => (
              <article class="capability-tile reveal" data-stagger={String(90 + index * 90)}>
                <div class="capability-tile__visual ambient-float">
                  <ProductFrame variant={tile.frame} {...tile.frameProps} />
                </div>
                <div class="capability-tile__copy">
                  <h3>{tile.title}</h3>
                  <p>{tile.copy}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
      <a class="text-link capability-section__cta" href="/producto">Ver todas las capacidades</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="integrations-intro reveal">
        <div>
          <p class="section-label">Integraciones</p>
          <h2 class="section-title">Se conecta con lo que ya usas.</h2>
          <p class="section-lead">Las citas de la clínica aparecen en los calendarios que el equipo ya abre cada día.</p>
        </div>
        <a class="text-link" href="/producto#integraciones">Ver integraciones</a>
      </div>
      <div class="integrations" aria-label="Integraciones de calendario" data-ambient>
        <article class="integrations__card reveal">
          <span class="integration-icon ambient-float" aria-hidden="true"><img src="/integrations/google-calendar.svg" alt="" width="40" height="40" /></span>
          <div>
            <h3>Google Calendar</h3>
            <p>Las citas de HabemusDandy se ven en el calendario de Google.</p>
          </div>
        </article>
        <article class="integrations__card reveal">
          <span class="integration-icon ambient-float ambient-float--late" aria-hidden="true"><img src="/integrations/apple-calendar.svg" alt="" width="40" height="40" /></span>
          <div>
            <h3>Apple Calendar</h3>
            <p>Consulta las mismas citas desde Apple Calendar.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <div class="story-bridge" aria-label="De las capacidades a los precios">
    <div class="container story-bridge__inner reveal">
      <span class="story-bridge__line" aria-hidden="true"></span>
      <p><strong>La operación ya está en el sistema.</strong> Elige el plan con el que quieres empezar.</p>
    </div>
  </div>

  <section class="section section--tight pricing-home">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Precios</p>
        <h2 class="section-title">Empieza gratis. Crece con tu equipo.</h2>
        <p class="section-lead">Tres opciones claras, con precio por asiento en Equipos. Promoción de lanzamiento: {monthlyPromo} {equiposPricing.currency} al mes, o {annualPromo} si pagas anual.</p>
      </div>
      <div class="pricing-home__billing reveal">
        <BillingToggle controls="home-pricing-plans" />
      </div>
      <div class="pricing-teaser" id="home-pricing-plans" data-billing="monthly">
        <article class="pricing-card reveal">
          <p class="pricing-card__eyebrow">Para comenzar</p>
          <h3>Gratis</h3>
          <p class="pricing-card__price">
            <strong aria-label="0 pesos mexicanos">$0</strong>
            <span class="price-unit">sin costo</span>
          </p>
          <p class="price-discount price-discount--spacer" aria-hidden="true"></p>
          <ul>
            <li>Agenda semanal y citas</li>
            <li>Clientes y fichas</li>
            <li>Notas clínicas</li>
          </ul>
          <a class="btn btn--ghost" href={appSignupUrl}>Comenzar gratis</a>
        </article>
        <article class="pricing-card pricing-card--featured reveal">
          <span class="pricing-card__badge">Recomendado</span>
          <p class="pricing-card__eyebrow">Para el equipo</p>
          <h3>Equipos</h3>
          <p class="pricing-card__price">
            <span class="billing-swap">
              <span class="price-amount" data-billing-content="monthly">
                <del aria-label={`Precio de lista ${equiposPricing.monthlyList} pesos mexicanos`}>{monthlyList}</del>
                <strong aria-label={`${equiposPricing.monthlyPromo} pesos mexicanos, promoción de lanzamiento`}>{monthlyPromo}</strong>
              </span>
              <span class="price-amount" data-billing-content="annual" hidden>
                <del aria-label={`Precio de lista ${equiposPricing.annualListPerMonth} pesos mexicanos`}>{annualList}</del>
                <strong aria-label={`${equiposPricing.annualPromoPerMonth} pesos mexicanos, promoción de lanzamiento`}>{annualPromo}</strong>
              </span>
            </span>
            <span class="price-unit">MXN / asiento / mes</span>
          </p>
          <p class="price-discount">
            <span class="billing-swap">
              <span data-billing-content="monthly">Promoción de lanzamiento</span>
              <span data-billing-content="annual" hidden>Lanzamiento · {annualBilled} al año</span>
            </span>
          </p>
          <ul>
            <li>Precio por asiento activo</li>
            <li>Formularios de ingreso</li>
            <li>Equipo, roles e integraciones</li>
          </ul>
          <a class="btn btn--primary" href={appSignupUrl}>Elegir Equipos</a>
        </article>
        <article class="pricing-card pricing-card--dark reveal">
          <p class="pricing-card__eyebrow">Operaciones grandes</p>
          <h3>Empresas</h3>
          <p class="pricing-card__price">
            <strong>A medida</strong>
            <span class="price-unit">según tu operación</span>
          </p>
          <p class="price-discount price-discount--spacer" aria-hidden="true"></p>
          <ul>
            <li>Todo lo de Equipos</li>
            <li>Configuración acompañada</li>
            <li>Condiciones a tu medida</li>
          </ul>
          <a class="btn btn--text pricing-card__sales" href={salesContactUrl}>Contactar a ventas</a>
        </article>
      </div>
      <a class="text-link pricing-home__link" href="/precios">Comparar todos los planes</a>
    </div>
  </section>

  <div class="story-bridge story-bridge--to-journey" aria-label="De los precios al recorrido">
    <div class="container story-bridge__inner reveal">
      <span class="story-bridge__line" aria-hidden="true"></span>
      <p><strong>El plan cubre la operación.</strong> Así se siente una visita, de la reserva a la nota.</p>
    </div>
  </div>

  <section class="section journey-section" id="recorrido">
    <div class="container">
      <div class="journey-intro reveal">
        <div>
          <p class="section-label">Una cita, de principio a fin</p>
          <h2 class="section-title">El contexto avanza con cada visita.</h2>
        </div>
        <div>
          <p class="section-lead">Cada paso deja listo el siguiente. El equipo atiende con el hilo a la vista, no reconstruyéndolo.</p>
          <a class="text-link" href={appSignupUrl}>Comenzar gratis</a>
        </div>
      </div>
      <ClinicJourney />
    </div>
  </section>

  <Faq items={faqItems} showSignupLink />
  <Cta showFlow />
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h) - env(safe-area-inset-top, 0px));
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .hero__grid {
    max-width: 100%;
    min-width: 0;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    max-width: 36rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 var(--space-4);
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    box-shadow: var(--shadow-card);
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.35rem, 5.4vw, 3.55rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.02;
    text-wrap: pretty;
  }

  .hero h1 span {
    color: var(--color-ink);
  }

  .hero__sub {
    margin: var(--space-4) 0 0;
    max-width: 32rem;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .hero__trust span::before {
    content: '\2713';
    margin-right: 0.4rem;
    color: var(--color-status-ok);
  }

  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    isolation: isolate;
  }

  .story-bridge {
    padding-block: 0 clamp(1.25rem, 3vw, 2.5rem);
  }

  .story-bridge--warm {
    background: color-mix(in srgb, var(--color-warm) 62%, transparent);
  }

  .story-bridge--to-journey {
    padding-bottom: 0;
  }

  .story-bridge__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: 52rem;
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    color: var(--color-muted);
    font-size: 0.96rem;
  }

  .story-bridge__inner p {
    margin: 0;
    text-wrap: pretty;
  }

  .story-bridge__inner strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .story-bridge__line {
    width: 2.5rem;
    height: 2px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--color-brand);
  }

  .hero__stage {
    position: relative;
    z-index: 2;
  }

  .hero__visual :global(.product-frame) {
    transform: perspective(1400px) rotateY(-5deg) rotateX(1.5deg);
    transform-origin: left center;
  }

  .hero__halo {
    position: absolute;
    inset: 10% 8% -12%;
    z-index: -1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    filter: blur(55px);
  }

  .signal-card {
    position: absolute;
    z-index: 3;
    display: none;
    align-items: center;
    gap: 0.7rem;
    min-width: 12.5rem;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    box-shadow: var(--shadow-card-hover);
    backdrop-filter: blur(12px);
  }

  :global(.js) .hero__visual:not(.is-visible) .signal-card {
    opacity: 0;
    transform: translateY(0.75rem);
  }

  .hero__visual.is-visible .signal-card {
    animation:
      signal-enter 640ms var(--ease-out) both,
      signal-float var(--duration-ambient) ease-in-out 900ms infinite;
  }

  .hero__visual.is-visible:not(.is-ambient) .signal-card {
    animation-play-state: running, paused;
  }

  .signal-card--intake {
    top: 14%;
    left: -1.1rem;
  }

  .signal-card--note {
    right: -0.6rem;
    bottom: 12%;
  }

  .hero__visual.is-visible .signal-card--intake {
    animation-delay: 180ms, 1080ms;
  }

  .hero__visual.is-visible .signal-card--note {
    animation-delay: 360ms, 1260ms;
  }

  .signal-card__icon {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-status-ok) 14%, var(--color-surface));
    color: var(--color-status-ok);
    font-size: 0.8rem;
  }

  .signal-card > span:last-child {
    display: grid;
  }

  .signal-card strong {
    font-size: 0.78rem;
    font-weight: 600;
  }

  .signal-card small {
    color: var(--color-muted);
    font-size: 0.67rem;
  }

  @keyframes signal-enter {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes signal-float {
    0%, 100% {
      transform: translateY(0);
      box-shadow: var(--shadow-card-hover);
    }
    50% {
      transform: translateY(calc(var(--shift-3) * -1));
      box-shadow: var(--shadow-float);
    }
  }

  .problem-cases,
  .setup-flow,
  .integrations,
  .pricing-teaser,
  .capability-bento {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .problem-section {
    padding-top: clamp(4rem, 8vw, 5.5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
    background: color-mix(in srgb, var(--color-warm) 62%, transparent);
