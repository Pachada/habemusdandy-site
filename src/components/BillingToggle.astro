---
import { equiposPricing, formatMxn } from '../config/site'

interface Props {
  controls: string
}

const { controls } = Astro.props
const monthlyList = formatMxn(equiposPricing.monthlyList)
const monthlyPromo = formatMxn(equiposPricing.monthlyPromo)
const annualList = formatMxn(equiposPricing.annualListPerMonth)
const annualPromo = formatMxn(equiposPricing.annualPromoPerMonth)
const annualBilled = formatMxn(equiposPricing.annualBilled)
const annualSavings = formatMxn(equiposPricing.annualSavings)
---

<div
  class="billing-toggle"
  data-billing-toggle
  data-controls={controls}
  data-monthly-list={monthlyList}
  data-monthly={monthlyPromo}
  data-annual-list={annualList}
  data-annual={annualPromo}
  data-billed={annualBilled}
  data-savings={annualSavings}
  data-discount={String(equiposPricing.annualDiscountPct)}
>
  <div class="billing-toggle__group" role="group" aria-label="Frecuencia de facturación">
    <button type="button" class="is-active" aria-pressed="true" aria-controls={controls} data-billing-option="monthly">
      Mensual
    </button>
    <button type="button" aria-pressed="false" aria-controls={controls} data-billing-option="annual">
      Anual
      <span>−{equiposPricing.annualDiscountPct}%</span>
    </button>
  </div>
  <p class="sr-only" aria-live="polite" data-billing-live>Facturación mensual seleccionada.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-billing-toggle]').forEach((toggle) => {
    if (toggle.dataset.ready === 'true') return

    const controls = toggle.dataset.controls
    const target = controls ? document.getElementById(controls) : null
    const buttons = Array.from(toggle.querySelectorAll<HTMLButtonElement>('[data-billing-option]'))
    const live = toggle.querySelector<HTMLElement>('[data-billing-live]')
    const monthlyList = toggle.dataset.monthlyList ?? '$249'
    const monthlyPrice = toggle.dataset.monthly ?? '$199'
    const annualList = toggle.dataset.annualList ?? '$199'
    const annualPrice = toggle.dataset.annual ?? '$149'
    const annualBilled = toggle.dataset.billed ?? '$1,788'
    const annualSavings = toggle.dataset.savings ?? '$600'
    const discount = toggle.dataset.discount ?? '25'
    if (!target || buttons.length === 0) return

    toggle.dataset.ready = 'true'

    const selectPeriod = (period: 'monthly' | 'annual') => {
      target.dataset.billing = period
      buttons.forEach((button) => {
        const selected = button.dataset.billingOption === period
        button.classList.toggle('is-active', selected)
        button.setAttribute('aria-pressed', String(selected))
      })
      target.querySelectorAll<HTMLElement>('[data-billing-content]').forEach((content) => {
        content.hidden = content.dataset.billingContent !== period
      })
      if (live) {
        live.textContent = period === 'annual'
          ? `Facturación anual seleccionada. Precio de lista ${annualList} pesos al mes. Promoción de lanzamiento: ${annualPrice} pesos mexicanos por asiento al mes, facturados como ${annualBilled} al año. Ahorras ${annualSavings} por asiento, un ${discount} por ciento frente a pagar mes a mes.`
          : `Facturación mensual seleccionada. Precio de lista ${monthlyList} pesos. Promoción de lanzamiento: ${monthlyPrice} pesos mexicanos por asiento al mes.`
      }
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const period = button.dataset.billingOption
        if (period === 'monthly' || period === 'annual') selectPeriod(period)
      })
      button.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft' && event.key !== 'Home' && event.key !== 'End') {
          return
        }
        event.preventDefault()
        const nextPeriod = event.key === 'ArrowRight' || event.key === 'End' ? 'annual' : 'monthly'
        selectPeriod(nextPeriod)
        buttons.find((item) => item.dataset.billingOption === nextPeriod)?.focus()
      })
    })

    selectPeriod('monthly')
  })
</script>

<style>
  .billing-toggle {
    width: fit-content;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .billing-toggle__group {
    display: inline-grid;
    grid-template-columns: repeat(2, auto);
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 5%, var(--color-surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0.58rem 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--motion-fast), color var(--motion-fast), box-shadow var(--motion-fast);
  }

  button:hover {
    color: var(--color-ink);
  }

  button.is-active {
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 5px 16px rgba(17, 25, 39, 0.09);
  }

  button span {
    color: var(--color-brand-deep);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  @media (max-width: 390px) {
    button {
      gap: 0.35rem;
      padding-inline: 0.72rem;
      font-size: 0.82rem;
    }

    button span {
      font-size: 0.64rem;
    }
  }
</style>
