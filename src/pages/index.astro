---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProductFrame from '../components/ProductFrame.astro'
import ClinicJourney from '../components/ClinicJourney.astro'
import BillingToggle from '../components/BillingToggle.astro'
import PlanAssurance from '../components/PlanAssurance.astro'
import Faq from '../components/Faq.astro'
import Cta from '../components/Cta.astro'
import { appSignupUrl, equiposPricing, faqItems, formatMxn, salesContactUrl } from '../config/site'

const monthlyList = formatMxn(equiposPricing.monthlyList)
const monthlyPromo = formatMxn(equiposPricing.monthlyPromo)
const annualList = formatMxn(equiposPricing.annualListPerMonth)
const annualPromo = formatMxn(equiposPricing.annualPromoPerMonth)
const annualBilled = formatMxn(equiposPricing.annualBilled)

const title = 'Software de citas para clínicas, consultorios y negocios'
const description =
  'Agenda, clientes, expediente, formularios de ingreso y recordatorios para clínicas, consultorios, estudios y cualquier negocio que trabaje con citas. Plan gratuito, no una prueba.'

const specialties = [
  { name: 'Fisioterapia', service: 'Valoración inicial', minutes: 60, tone: 'brand' },
  { name: 'Odontología', service: 'Limpieza dental', minutes: 45, tone: 'ok' },
  { name: 'Psicología', service: 'Sesión individual', minutes: 50, tone: 'warn' },
  { name: 'Nutrición', service: 'Consulta de seguimiento', minutes: 30, tone: 'idle' },
  { name: 'Estética', service: 'Limpieza facial', minutes: 60, tone: 'ink' },
] as const

const setupSteps = [
  {
    n: '01',
    title: 'Define tu horario',
    line: 'Los días y horas en que atiendes.',
    note: '',
    frame: 'hours' as const,
    frameProps: { compact: true, micro: 'availability' as const, activeNav: 'Horario', label: 'Disponibilidad' },
  },
  {
    n: '02',
    title: 'Da de alta tus servicios',
    line: 'Qué ofreces, cuánto dura y cuánto cuesta.',
    note: '',
    frame: 'services' as const,
    frameProps: { compact: true, activeNav: 'Servicios', label: 'Servicios' },
  },
  {
    n: '03',
    title: 'Prepara el formulario de ingreso',
    line: 'Los datos y el motivo de la cita que quieres saber antes de atender.',
    note: 'Formularios de ingreso: en Equipos y Empresas.',
    frame: 'intake' as const,
    frameProps: { compact: true, activeNav: 'Formularios', label: 'Formulario de ingreso' },
  },
] as const

const capabilityTiles = [
  {
    title: 'Servicios',
    copy: 'Color por servicio, para distinguir cada atención de un vistazo.',
    frame: 'services' as const,
    frameProps: { compact: true, micro: 'chips' as const, activeNav: 'Servicios', label: 'Color por servicio' },
  },
  {
    title: 'Formularios',
    copy: 'Tu marca, consentimiento y firma en el mismo formulario.',
    frame: 'intake' as const,
    frameProps: { compact: true, micro: 'consent' as const, activeNav: 'Formularios', label: 'Consentimiento y firma' },
  },
  {
    title: 'Horario',
    copy: 'Excepciones de fecha y zona horaria, sin rehacer la semana.',
    frame: 'hours' as const,
    frameProps: { compact: true, micro: 'exception' as const, activeNav: 'Horario', label: 'Excepción de fecha' },
  },
  {
    title: 'Equipo y roles',
    copy: 'Acceso según el rol: Owner, Manager o Staff, sin compartirlo todo.',
    frame: 'team' as const,
    frameProps: { compact: true, micro: 'team' as const, activeNav: 'Administración', label: 'Roles del equipo' },
  },
] as const
---

<BaseLayout title={title} description={description}>
  <section class="hero section">
    <div class="container hero__grid">
      <div class="hero__copy reveal">
        <p class="hero__eyebrow"><span class="status-dot status-dot--ok"></span> Software para negocios con citas</p>
        <h1>Tu negocio, en un solo lugar.</h1>
        <p class="hero__sub">
          Citas, clientes, expediente, formularios y recordatorios, fuera del chat y del calendario compartido.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={appSignupUrl}>Comenzar gratis</a>
          <a class="btn btn--ghost" href="#recorrido">Ver una visita</a>
        </div>
        <p class="hero__trust"><span>Plan gratuito, no una prueba</span><span>Configuración en minutos</span></p>
      </div>
      <div class="hero__visual reveal" data-reveal="scale" data-ambient>
        <div class="hero__halo" aria-hidden="true"></div>
        <div class="hero__stage ambient-float ambient-float--slow">
          <ProductFrame variant="panel" activeNav="Panel principal" label="Agenda de hoy" />
          <div class="signal-card signal-card--intake">
            <span class="signal-card__icon" aria-hidden="true">✓</span>
            <span><strong>Ingreso completo</strong><small>Ana Rojas · hace 2 min</small></span>
          </div>
          <div class="signal-card signal-card--note">
            <span class="status-dot status-dot--brand"></span>
            <span><strong>Nota lista</strong><small>Sesión anterior vinculada</small></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section problem-section" data-ambient>
    <div class="container">
      <div class="reveal">
        <p class="section-label">Problema</p>
        <h2 class="section-title">Hoy tu negocio se arma en el chat.</h2>
      </div>
      <div class="problem-cases">
        <article class="problem-card problem-card--lead reveal">
          <div class="problem-card__scene" aria-hidden="true">
            <div class="pain-chat">
              <p class="pain-chat__meta">Chat · Interesado</p>
              <p class="pain-chat__bubble pain-chat__bubble--in">¿Tienes el jueves a las 5?</p>
              <p class="pain-chat__bubble pain-chat__bubble--out">Deja checo y te aviso</p>
              <p class="pain-chat__waiting">Sin respuesta · 2 h</p>
            </div>
          </div>
          <div class="problem-card__copy">
            <h3>Dijiste que revisabas y no contestaste</h3>
            <p>El interesado pregunta si hay hueco. Tú ibas a mirar el horario. El mensaje se quedó visto.</p>
          </div>
        </article>
        <article class="problem-card reveal">
          <div class="problem-card__scene" aria-hidden="true">
            <div class="pain-ficha">
              <div class="pain-ficha__head">
                <strong>Sofía P.</strong>
                <span>Ficha</span>
              </div>
              <dl>
                <div><dt>Teléfono</dt><dd>· · ·</dd></div>
                <div><dt>Última visita</dt><dd class="is-empty">Sin historial</dd></div>
              </dl>
              <ul class="pain-ficha__visits">
                <li class="is-empty"><span>Visitas</span><span>Sin registros</span></li>
                <li class="is-empty"><span>Nota previa</span><span>No disponible</span></li>
              </ul>
            </div>
          </div>
          <div class="problem-card__copy">
            <h3>Cada visita empieza de cero</h3>
            <p>Lo de la sesión pasada no está en la ficha. Vuelves a preguntar lo que ya sabías.</p>
          </div>
        </article>
        <article class="problem-card reveal">
          <div class="problem-card__scene" aria-hidden="true">
            <div class="pain-follow">
              <div class="pain-follow__bar">
                <span class="status-dot"></span>
                Sesión 6 · finalizada
              </div>
              <ul>
                <li><span class="status-dot status-dot--warn"></span> Sin próxima</li>
                <li><span class="status-dot status-dot--warn"></span> Plan no registrado</li>
              </ul>
            </div>
          </div>
          <div class="problem-card__copy">
            <h3>La sesión termina y el hilo se corta</h3>
            <p>No hay próxima cita, ni plan a la vista, ni recordatorio. El seguimiento vive en la cabeza.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <div class="story-bridge story-bridge--warm" aria-label="Del problema a la visita">
    <div class="container story-bridge__inner reveal">
      <span class="story-bridge__line" aria-hidden="true"></span>
      <p><strong>El chat no es un sistema.</strong> Así se ve el mismo jueves cuando la visita vive en un solo lugar.</p>
    </div>
  </div>

  <section class="section journey-section" id="recorrido">
    <div class="container">
      <div class="journey-intro reveal">
        <div>
          <p class="section-label">Una cita, de principio a fin</p>
          <h2 class="section-title">El contexto avanza con cada visita.</h2>
        </div>
        <div>
          <p class="section-lead">Cada paso deja listo el siguiente. El equipo atiende con el hilo a la vista, no reconstruyéndolo.</p>
          <a class="text-link" href={appSignupUrl}>Comenzar gratis</a>
        </div>
      </div>
      <ClinicJourney />
    </div>
  </section>

  <section class="section setup-section" id="como-empezar">
    <div class="container">
      <div class="setup-intro reveal">
        <p class="section-label">Cómo empezar</p>
        <h2 class="section-title">Empezar no debería tomar una semana.</h2>
        <p class="section-lead">
          Horario, servicios y formulario de ingreso. Con eso, la próxima visita corre como la acabas de ver.
        </p>
        <div class="setup-intro__actions">
          <a class="btn btn--primary" href={appSignupUrl}>Comenzar gratis</a>
        </div>
      </div>
      <ol class="setup-flow">
        {
          setupSteps.map((step, index) => (
            <li class="setup-step reveal" data-stagger={String(index * 90)}>
              <article class="setup-card">
                <div class="setup-card__body">
                  <span class="setup-card__n">{step.n}</span>
                  <h3>{step.title}</h3>
                  <p>{step.line}</p>
                  {step.note && <p class="plan-note">{step.note}</p>}
                </div>
                <div class="setup-card__frame">
                  <ProductFrame variant={step.frame} {...step.frameProps} />
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight specialty-section" aria-labelledby="especialidades-titulo">
    <div class="container specialty-layout">
      <div class="specialty-intro reveal">
        <p class="section-label">Para quién</p>
        <h2 class="section-title" id="especialidades-titulo">Funciona en cualquier negocio con citas.</h2>
        <p class="section-lead">
          Tú das de alta los servicios, su duración y el formulario de ingreso. Horaya se acomoda a tu giro, no al revés.
        </p>
      </div>
      <ul class="specialty-list reveal" data-stagger="90">
        {
          specialties.map((item) => (
            <li class="specialty-row">
              <span class="specialty-row__name">{item.name}</span>
              <span class="specialty-row__service">
                <i class={`specialty-row__swatch specialty-row__swatch--${item.tone}`} aria-hidden="true"></i>
                {item.service}
              </span>
              <span class="specialty-row__time">{item.minutes} min</span>
            </li>
          ))
        }
        <li class="specialty-row specialty-row--yours">
          <span class="specialty-row__name">Tu negocio</span>
          <span class="specialty-row__service">
            <i class="specialty-row__swatch specialty-row__swatch--empty" aria-hidden="true"></i>
            Tus servicios, con su duración y su color
          </span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--tight capability-section">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Más que una agenda</p>
        <h2 class="section-title">La operación alrededor de la visita.</h2>
        <p class="section-lead">El panel del día, los roles del equipo y el detalle de cada pieza. Sin otra herramienta.</p>
      </div>
      <div class="capability-bento" aria-label="Capacidades operativas del negocio">
        <article class="capability-bento__panel reveal" data-stagger="0">
          <div class="capability-bento__visual">
            <ProductFrame variant="panel" compact micro="panel" activeNav="Panel principal" label="Panel principal" />
          </div>
          <div class="capability-bento__copy">
            <p class="capability-bento__eyebrow">Panel principal</p>
            <h3>Hoy, sin buscar en cinco lugares.</h3>
            <p>Citas de hoy, estados y acciones rápidas en la vista que abre el equipo.</p>
          </div>
        </article>
        <div class="capability-bento__tiles">
          {
            capabilityTiles.map((tile, index) => (
              <article class="capability-tile reveal" data-stagger={String(90 + index * 90)}>
                <div class="capability-tile__visual">
                  <ProductFrame variant={tile.frame} {...tile.frameProps} />
                </div>
                <div class="capability-tile__copy">
                  <h3>{tile.title}</h3>
                  <p>{tile.copy}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
      <p class="plan-note capability-section__note">Formularios, equipo y roles: en Equipos y Empresas.</p>
      <a class="text-link capability-section__cta" href="/producto">Ver todas las capacidades</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="integrations-intro reveal">
        <div>
          <p class="section-label">Integraciones</p>
          <h2 class="section-title">Se conecta con lo que ya usas.</h2>
          <p class="section-lead">Las citas de tu negocio aparecen en los calendarios que el equipo ya abre cada día.</p>
          <p class="plan-note">Incluido en Equipos y Empresas.</p>
        </div>
        <a class="text-link" href="/producto#integraciones">Ver integraciones</a>
      </div>
      <div class="integrations" aria-label="Integraciones de calendario">
        <article class="integrations__card reveal">
          <span class="integration-icon" aria-hidden="true"><img src="/integrations/google-calendar.svg" alt="" width="40" height="40" loading="lazy" decoding="async" /></span>
          <div>
            <h3>Google Calendar</h3>
            <p>Las citas de Horaya se ven en el calendario de Google.</p>
          </div>
        </article>
        <article class="integrations__card reveal">
          <span class="integration-icon" aria-hidden="true"><img src="/integrations/apple-calendar.svg" alt="" width="40" height="40" loading="lazy" decoding="async" /></span>
          <div>
            <h3>Apple Calendar</h3>
            <p>Consulta las mismas citas desde Apple Calendar.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <div class="story-bridge story-bridge--to-pricing" aria-label="De los calendarios a los precios">
    <div class="container story-bridge__inner reveal">
      <span class="story-bridge__line" aria-hidden="true"></span>
      <p><strong>El plan cubre la operación.</strong> Elige la capacidad con la que empiezas.</p>
    </div>
  </div>

  <section class="section section--tight pricing-home">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Precios</p>
        <h2 class="section-title">Empieza gratis. Crece con tu equipo.</h2>
        <p class="section-lead">Tres opciones claras, con precio por asiento en Equipos. Promoción de lanzamiento: {monthlyPromo} {equiposPricing.currency} al mes, o {annualPromo} si pagas anual.</p>
      </div>
      <div class="pricing-home__billing reveal">
        <BillingToggle controls="home-pricing-plans" />
      </div>
      <div class="pricing-teaser" id="home-pricing-plans" data-billing="monthly">
        <article class="pricing-card reveal">
          <p class="pricing-card__eyebrow">Para comenzar</p>
          <h3>Gratis</h3>
          <p class="pricing-card__price">
            <strong aria-label="0 pesos mexicanos">$0</strong>
            <span class="price-unit">sin costo</span>
          </p>
          <p class="price-discount price-discount--spacer" aria-hidden="true"></p>
          <ul>
            <li>Agenda semanal y citas</li>
            <li>Clientes y fichas</li>
            <li>Notas de cada visita</li>
            <li>Servicios y horario</li>
          </ul>
          <a class="btn btn--ghost" href={appSignupUrl}>Comenzar gratis</a>
        </article>
        <article class="pricing-card pricing-card--featured reveal">
          <span class="pricing-card__badge">Recomendado</span>
          <p class="pricing-card__eyebrow">Para el equipo</p>
          <h3>Equipos</h3>
          <p class="pricing-card__price">
            <span class="billing-swap">
              <span class="price-amount" data-billing-content="monthly">
                <del aria-label={`Precio de lista ${equiposPricing.monthlyList} pesos mexicanos`}>{monthlyList}</del>
                <strong aria-label={`${equiposPricing.monthlyPromo} pesos mexicanos, promoción de lanzamiento`}>{monthlyPromo}</strong>
              </span>
              <span class="price-amount" data-billing-content="annual" hidden>
                <del aria-label={`Precio de lista ${equiposPricing.annualListPerMonth} pesos mexicanos`}>{annualList}</del>
                <strong aria-label={`${equiposPricing.annualPromoPerMonth} pesos mexicanos, promoción de lanzamiento`}>{annualPromo}</strong>
              </span>
            </span>
            <span class="price-unit">MXN / asiento / mes, IVA incluido</span>
          </p>
          <p class="price-discount">
            <span class="billing-swap">
              <span data-billing-content="monthly">Promoción de lanzamiento</span>
              <span data-billing-content="annual" hidden>Lanzamiento · {annualBilled} al año</span>
            </span>
          </p>
          <ul>
            <li>Precio por asiento activo</li>
            <li>Formularios de ingreso</li>
            <li>Equipo, roles e integraciones</li>
            <li>Automatizaciones y reportes</li>
          </ul>
          <a class="btn btn--primary" href={appSignupUrl}>Comenzar</a>
          <p class="pricing-card__note">El plan lo eliges en el panel.</p>
        </article>
        <article class="pricing-card pricing-card--dark reveal">
          <p class="pricing-card__eyebrow">Operaciones grandes</p>
          <h3>Empresas</h3>
          <p class="pricing-card__price">
            <strong>A medida</strong>
            <span class="price-unit">según tu operación</span>
          </p>
          <p class="price-discount price-discount--spacer" aria-hidden="true"></p>
          <ul>
            <li>Todo lo de Equipos</li>
            <li>Configuración acompañada</li>
            <li>Condiciones a tu medida</li>
          </ul>
          <a class="btn btn--text pricing-card__sales" href={salesContactUrl}>Contactar a ventas</a>
          <p class="pricing-card__note pricing-card__note--on-dark">Te responde una persona del equipo.</p>
        </article>
      </div>
      <PlanAssurance />
      <a class="text-link pricing-home__link" href="/precios">Comparar todos los planes</a>
    </div>
  </section>

  <Faq items={faqItems} showSignupLink />
  <Cta showFlow />
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h) - env(safe-area-inset-top, 0px));
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .hero__grid {
    max-width: 100%;
    min-width: 0;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    max-width: 36rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 var(--space-4);
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    box-shadow: var(--shadow-card);
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.35rem, 5.4vw, 3.55rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.02;
    text-wrap: pretty;
  }

  .hero h1 span {
    color: var(--color-ink);
  }

  .hero__sub {
    margin: var(--space-4) 0 0;
    max-width: 32rem;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .hero__trust span::before {
    content: '\2713';
    margin-right: 0.4rem;
    color: var(--color-status-ok);
  }

  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    isolation: isolate;
  }

  .story-bridge {
    padding-block: 0 clamp(1.25rem, 3vw, 2.5rem);
  }

  .story-bridge--warm {
    background: color-mix(in srgb, var(--color-warm) 62%, transparent);
  }

  .story-bridge--to-pricing {
    padding-bottom: 0;
  }

  .pricing-card__note {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .pricing-card__note--on-dark {
    color: color-mix(in srgb, var(--color-surface) 68%, transparent);
  }

  .story-bridge__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: 52rem;
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    color: var(--color-muted);
    font-size: 0.96rem;
  }

  .story-bridge__inner p {
    margin: 0;
    text-wrap: pretty;
  }

  .story-bridge__inner strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .story-bridge__line {
    width: 2.5rem;
    height: 2px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--color-brand);
  }

  .hero__stage {
    position: relative;
    z-index: 2;
  }

  .hero__halo {
    position: absolute;
    inset: 10% 8% -12%;
    z-index: -1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    filter: blur(55px);
  }

  .signal-card {
    position: absolute;
    z-index: 3;
    display: none;
    align-items: center;
    gap: 0.7rem;
    min-width: 12.5rem;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    box-shadow: var(--shadow-card-hover);
    backdrop-filter: blur(12px);
  }

  :global(.js) .hero__visual:not(.is-visible) .signal-card {
    opacity: 0;
    transform: translateY(0.75rem);
  }

  .hero__visual.is-visible .signal-card {
    animation:
      signal-enter 640ms var(--ease-out) both,
      signal-float var(--duration-ambient) ease-in-out 900ms infinite;
  }

  .hero__visual.is-visible:not(.is-ambient) .signal-card {
    animation-play-state: running, paused;
  }

