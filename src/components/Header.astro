---
import { appLoginUrl, appSignupUrl, navLinks, siteName } from '../config/site'

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="site-header" data-site-header>
  <div class="site-header__inner container">
    <a class="site-header__logo" href="/" aria-label={`${siteName}, inicio`}>
      <img src="/logo.svg" alt="" width="118" height="32" decoding="async" />
    </a>

    <nav class="site-header__nav" aria-label="Principal">
      {
        navLinks.map((link) => (
          <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--text site-header__login" href={appLoginUrl}>Iniciar sesión</a>
      <a class="btn btn--primary" href={appSignupUrl}>Comenzar gratis</a>
    </div>

    <button
      class="site-header__menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Abrir menú"
      data-menu-open
    >
      <span>Menú</span>
      <span class="site-header__menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="mobile-drawer" id="mobile-nav" hidden data-mobile-drawer>
  <div class="mobile-drawer__backdrop" data-menu-close tabindex="-1"></div>
  <div
    class="mobile-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-label="Navegación"
  >
    <div class="mobile-drawer__top">
      <p class="mobile-drawer__title">{siteName}</p>
      <button class="btn btn--ghost" type="button" data-menu-close>Cerrar</button>
    </div>
    <nav class="mobile-drawer__nav" aria-label="Móvil">
      {
        navLinks.map((link) => (
          <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a href={appLoginUrl}>Iniciar sesión</a>
      <a class="btn btn--primary" href={appSignupUrl}>Comenzar gratis</a>
    </nav>
  </div>
</div>

<script>
  const drawer = document.querySelector('[data-mobile-drawer]') as HTMLElement | null
  const openBtn = document.querySelector('[data-menu-open]') as HTMLButtonElement | null
  if (drawer && openBtn) {
    const focusableSelector =
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
    let lastFocus: HTMLElement | null = null

    const setOpen = (open: boolean) => {
      drawer.hidden = !open
      openBtn.setAttribute('aria-expanded', String(open))
      document.body.style.overflow = open ? 'hidden' : ''
      if (open) {
        lastFocus = document.activeElement as HTMLElement
        const panel = drawer.querySelector('.mobile-drawer__panel') as HTMLElement
        const first = panel.querySelector(focusableSelector) as HTMLElement | null
        first?.focus()
      } else {
        lastFocus?.focus()
      }
    }

    openBtn.addEventListener('click', () => setOpen(true))
    drawer.querySelectorAll('[data-menu-close]').forEach((el) => {
      el.addEventListener('click', () => setOpen(false))
    })
    drawer.querySelectorAll('a').forEach((el) => {
      el.addEventListener('click', () => setOpen(false))
    })
    document.addEventListener('keydown', (event) => {
      if (drawer.hidden) return
      if (event.key === 'Escape') {
        setOpen(false)
        return
      }
      if (event.key !== 'Tab') return
      const panel = drawer.querySelector('.mobile-drawer__panel')
      if (!panel) return
      const nodes = [...panel.querySelectorAll<HTMLElement>(focusableSelector)].filter(
        (el) => !el.hasAttribute('disabled') && el.tabIndex !== -1,
      )
      if (nodes.length === 0) return
      const first = nodes[0]
      const last = nodes[nodes.length - 1]
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    })
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: calc(var(--header-h) + env(safe-area-inset-top, 0px));
    padding-top: env(safe-area-inset-top, 0px);
    border-bottom: 1px solid transparent;
    background: rgba(250, 250, 248, 0.82);
    backdrop-filter: blur(18px) saturate(130%);
    transition: box-shadow var(--motion-base), background var(--motion-base);
  }

  .site-header.is-scrolled {
    border-bottom-color: rgba(0, 0, 0, 0.07);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-header);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-5);
    height: 100%;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .site-header__logo img {
    width: auto;
    height: 1.8rem;
  }

  .site-header__nav {
    display: none;
    justify-content: center;
    gap: 2.2rem;
  }

  .site-header__nav a {
    position: relative;
    color: var(--color-ink-mid);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }

  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.55rem;
    height: 1px;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--motion-base);
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--color-ink);
  }

  .site-header__nav a:hover::after,
  .site-header__nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__actions {
    display: none;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    justify-self: end;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid rgba(0, 0, 0, 0.11);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-ink);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
  }

  .site-header__menu-icon {
    display: grid;
    gap: 0.25rem;
    width: 0.9rem;
  }

  .site-header__menu-icon i {
    display: block;
    height: 1px;
    background: currentColor;
  }

  .mobile-drawer[hidden] {
    display: none;
  }

  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 50;
    animation: drawer-in 180ms ease-out;
  }

  .mobile-drawer__backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-overlay);
  }

  .mobile-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(22rem, 100%);
    height: 100%;
    padding: calc(var(--space-5) + env(safe-area-inset-top, 0px)) max(var(--space-4), env(safe-area-inset-right, 0px)) calc(var(--space-6) + env(safe-area-inset-bottom, 0px)) max(var(--space-4), env(safe-area-inset-left, 0px));
    background: var(--color-surface);
    box-shadow: var(--shadow-card-hover);
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-5);
  }

  .mobile-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .mobile-drawer__title {
    margin: 0;
    font-weight: 600;
  }

  .mobile-drawer__nav {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .mobile-drawer__nav a {
    padding: 0.9rem var(--space-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 500;
  }

  .mobile-drawer__nav a:hover,
  .mobile-drawer__nav a[aria-current='page'] {
    background: var(--color-ink-soft);
  }

  .mobile-drawer__nav .btn--primary {
    margin-top: var(--space-3);
  }

  @keyframes drawer-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (min-width: 860px) {
    .site-header__nav,
    .site-header__actions {
      display: flex;
    }

    .site-header__menu-btn {
      display: none;
    }
  }

  @media (max-width: 859px) {
    .site-header__inner {
      grid-template-columns: 1fr auto auto;
      gap: var(--space-3);
    }

    .site-header__logo {
      min-width: 0;
    }

    .site-header__logo img {
      width: min(8.8rem, 100%);
      height: auto;
    }

    .site-header__actions {
      display: flex;
    }

    .site-header__actions .btn--primary {
      min-height: 2.75rem;
      padding: 0.52rem 0.85rem;
      font-size: 0.82rem;
      white-space: nowrap;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .site-header__actions .btn--primary::after {
      display: none;
    }

    .site-header__login {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .site-header__inner {
      width: calc(100% - 1rem);
      gap: 0.4rem;
    }

    .site-header__logo img {
      width: min(6.9rem, 100%);
    }

    .site-header__actions .btn--primary {
      min-height: 2.75rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.78rem;
      white-space: nowrap;
    }

    .site-header__menu-btn {
      min-height: 2.75rem;
      min-width: 2.75rem;
      padding: 0.4rem 0.65rem;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 360px) {
    .site-header__inner {
      gap: 0.25rem;
    }

    .site-header__menu-btn {
      min-width: 2.75rem;
      min-height: 2.75rem;
      justify-content: center;
    }

    .site-header__menu-btn > span:first-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-drawer { animation: none; }
  }
</style>
