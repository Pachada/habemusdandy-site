    gap: 0.35rem;
  }

  .pain-ficha__visits li {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-status-idle) 14%, var(--color-surface));
    color: var(--color-muted);
    font-size: 0.75rem;
    opacity: 0.72;
  }

  .pain-follow {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 0.2rem;
  }

  .pain-follow__bar {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-status-idle) 18%, var(--color-surface));
    color: var(--color-ink);
    font-size: 0.72rem;
    font-weight: 600;
