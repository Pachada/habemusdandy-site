    align-items: baseline;
    gap: 0.5rem;
  }

  .pain-ficha__head strong {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .pain-ficha__head span {
    color: var(--color-muted);
