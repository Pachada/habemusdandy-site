    display: grid;
    align-content: start;
    gap: 0.65rem;
    padding: 0.2rem;
  }

  .pain-ficha__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .pain-ficha__head strong {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.02em;
