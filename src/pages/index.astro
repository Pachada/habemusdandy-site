    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.78rem;
  }

  .pain-ficha dt {
    color: var(--color-muted);
  }

  .pain-ficha dd {
    margin: 0;
    color: var(--color-muted);
    font-weight: 500;
  }

  .pain-ficha dd.is-empty,
  .pain-ficha__visits .is-empty span:last-child {
    color: color-mix(in srgb, var(--color-muted) 72%, transparent);
    font-style: italic;
    font-weight: 400;
  }

  .pain-ficha__visits {
    margin: 0;
    padding: 0;
    list-style: none;
