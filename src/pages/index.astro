    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.8rem;
    box-shadow: var(--shadow-card);
