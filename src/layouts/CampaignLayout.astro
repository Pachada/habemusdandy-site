---
import '../styles/global.css'
import CookieNotice from '../components/CookieNotice.astro'
import Wordmark from '../components/Wordmark.astro'
import { appLoginUrl, appSignupUrl, salesEmail, siteName } from '../config/site'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const pageTitle = title.includes(siteName) ? title : `${title} · ${siteName}`
const legal = [
  { href: '/privacidad', label: 'Políticas de privacidad' },
  { href: '/terminos', label: 'Términos y condiciones' },
  { href: '/seguridad', label: 'Seguridad' },
] as const
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    <title>{pageTitle}</title>
  </head>
  <body data-campaign>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="campaign-header" data-site-header>
      <div class="campaign-header__inner container">
        <a class="campaign-header__logo" href="#inicio">
          <Wordmark />
        </a>
        <a class="campaign-header__mail" href={`mailto:${salesEmail}`}>{salesEmail}</a>
        <a class="btn btn--primary campaign-header__cta" href={appSignupUrl}>Comenzar gratis</a>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="campaign-footer">
      <div class="container campaign-footer__inner">
        <div class="campaign-footer__brand">
          <Wordmark />
          <a href={`mailto:${salesEmail}`}>{salesEmail}</a>
        </div>
        <ul>
          {
            legal.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
          <li><a href={appLoginUrl}>Iniciar sesión</a></li>
        </ul>
      </div>
      <div class="container campaign-footer__bottom">
        <span>© {new Date().getFullYear()} {siteName}</span>
      </div>
    </footer>
    <div class="sticky-cta" data-sticky-cta>
      <p>Plan gratuito. El plan se elige en el panel.</p>
      <a class="btn btn--primary" href={appSignupUrl}>Comenzar gratis</a>
    </div>
    <CookieNotice />
    <script>
      const header = document.querySelector('[data-site-header]')
      const onScroll = () => {
        if (!header) return
        header.classList.toggle('is-scrolled', window.scrollY > 8)
      }
      onScroll()
      window.addEventListener('scroll', onScroll, { passive: true })

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      if (!reduceMotion) {
        const reveals = document.querySelectorAll('.reveal')
        if ('IntersectionObserver' in window) {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible')
                  revealObserver.unobserve(entry.target)
                }
              }
            },
            { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
          )
          reveals.forEach((el) => revealObserver.observe(el))
        } else {
          reveals.forEach((el) => el.classList.add('is-visible'))
        }
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'))
      }

      if (!reduceMotion && 'IntersectionObserver' in window) {
        document.querySelectorAll('[data-ambient]').forEach((el) => {
          const observer = new IntersectionObserver(
            ([entry]) => {
              el.classList.toggle('is-ambient', Boolean(entry?.isIntersecting))
            },
            { threshold: 0.22 },
          )
          observer.observe(el)
        })
      }

      const heroCta = document.querySelector('[data-hero-cta]')
      const sticky = document.querySelector('[data-sticky-cta]')
      const cookie = document.querySelector('[data-cookie-notice]')
      const mobile = window.matchMedia('(max-width: 859px)')

      const syncClearance = () => {
        const stickyOn = Boolean(sticky && mobile.matches && sticky.classList.contains('is-fixed'))
        const stickyH = stickyOn && sticky ? sticky.getBoundingClientRect().height : 0
        const cookieOn = cookie instanceof HTMLElement && !cookie.hidden && cookie.classList.contains('is-ready')
        const cookieH = cookieOn ? cookie.getBoundingClientRect().height : 0
        const gap = cookieOn && stickyOn ? 10 : 0
        const total = stickyH + cookieH + gap
        document.body.style.paddingBottom = total > 0 ? `${total}px` : ''
        if (cookie instanceof HTMLElement) {
          cookie.style.bottom = cookieOn && stickyOn ? `${stickyH + 8}px` : ''
        }
      }

      if (heroCta && sticky && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            sticky.classList.toggle('is-fixed', mobile.matches && !entry.isIntersecting)
            syncClearance()
          },
          { threshold: 0.35 },
        )
        observer.observe(heroCta)
        mobile.addEventListener('change', () => {
          if (!mobile.matches) sticky.classList.remove('is-fixed')
          syncClearance()
        })
      }

      if (cookie) {
        new MutationObserver(syncClearance).observe(cookie, {
          attributes: true,
          attributeFilter: ['hidden', 'class'],
        })
      }
      window.addEventListener('resize', syncClearance, { passive: true })
      syncClearance()
    </script>
  </body>
</html>

<style>
  body[data-campaign] ::selection {
    background: var(--color-brand-soft);
    color: var(--color-ink);
  }

  .campaign-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: calc(var(--header-h) + env(safe-area-inset-top, 0px));
    padding-top: env(safe-area-inset-top, 0px);
    background: rgba(250, 250, 248, 0.9);
    backdrop-filter: blur(18px) saturate(130%);
  }

  .campaign-header.is-scrolled {
    background: rgba(255, 255, 255, 0.94);
    box-shadow: var(--shadow-header);
  }

  .campaign-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
  }

  .campaign-header__logo {
    margin-right: auto;
    text-decoration: none;
  }

  .campaign-header__mail {
    color: var(--color-ink-mid);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
  }

  .campaign-header__mail:hover {
    color: var(--color-ink);
  }

  .campaign-header__cta {
    display: none;
  }

  .campaign-footer {
    padding: clamp(3rem, 7vw, 5rem) 0 calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    background: var(--color-surface);
  }

  .campaign-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .campaign-footer__brand {
    display: grid;
    gap: var(--space-3);
    --wordmark-size: 1.35rem;
  }

  .campaign-footer__brand a,
  .campaign-footer a {
    color: var(--color-ink-mid);
    text-decoration: none;
  }

  .campaign-footer a:hover {
    color: var(--color-ink);
  }

  .campaign-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .campaign-footer__bottom {
    margin-top: var(--space-6);
    color: var(--color-ink-mid);
    font-size: 0.88rem;
  }

  .sticky-cta {
    display: none;
    position: fixed;
    z-index: 34;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    gap: var(--space-3);
    padding: 0.75rem max(1rem, env(safe-area-inset-right, 0px)) calc(0.75rem + env(safe-area-inset-bottom, 0px))
      max(1rem, env(safe-area-inset-left, 0px));
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.08);
  }

  .sticky-cta p {
    margin: 0;
    color: var(--color-ink-mid);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .sticky-cta .btn {
    flex-shrink: 0;
    min-height: 2.75rem;
  }

  @media (min-width: 640px) {
    .campaign-header__mail {
      display: inline;
    }
  }

  @media (max-width: 639px) {
    .campaign-header__mail {
      display: none;
    }
  }

  @media (min-width: 860px) {
    .campaign-header__cta {
      display: inline-flex;
    }
  }

  @media (max-width: 859px) {
    html:not(.js) .sticky-cta,
    .sticky-cta.is-fixed {
      display: flex;
    }

    html:not(.js) body[data-campaign] {
      padding-bottom: calc(4.6rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (max-width: 420px) {
    .sticky-cta p {
      display: none;
    }

    .sticky-cta .btn {
      flex: 1;
    }
  }
</style>
