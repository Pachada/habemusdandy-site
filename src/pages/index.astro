---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProductFrame from '../components/ProductFrame.astro'
import ClinicJourney from '../components/ClinicJourney.astro'
import BillingToggle from '../components/BillingToggle.astro'
import Faq from '../components/Faq.astro'
import Cta from '../components/Cta.astro'
import { appSignupUrl, faqItems, salesContactUrl } from '../config/site'

const title = 'Tu clínica ordenada, de la cita al seguimiento'
const description =
  'Agenda, formularios, fichas y notas clínicas en un solo flujo. HabemusDandy organiza la operación de la clínica.'

const setupSteps = [
  {
    n: '01',
    title: 'Define horario y servicios',
    line: 'Cuándo atiendes y qué ofreces',
    frame: 'hours' as const,
    frameProps: { compact: true, micro: 'availability', activeNav: 'Horario', label: 'Disponibilidad' },
  },
  {
    n: '02',
    title: 'Recibe la reserva',
    line: 'El hueco queda en la agenda, no en el chat',
    frame: 'agenda' as const,
    frameProps: { crop: true, compact: true, micro: 'reservation', activeNav: 'Citas', label: 'Reserva confirmada' },
  },
  {
    n: '03',
    title: 'Atiende con la ficha lista',
    line: 'Datos y visitas anteriores al abrir',
    frame: 'client' as const,
    frameProps: { compact: true, micro: 'record', activeNav: 'Clientes', label: 'Ficha preparada' },
  },
] as const

const capabilityTiles = [
  {
    title: 'Servicios',
    copy: 'Duración, precio y color de cada atención, listos para reservar.',
    frame: 'services' as const,
    frameProps: { compact: true, micro: 'services', activeNav: 'Servicios', label: 'Servicios de la clínica' },
  },
  {
    title: 'Formularios',
    copy: 'Ingreso con tu marca, consentimiento y firma en el mismo flujo.',
    frame: 'intake' as const,
    frameProps: { compact: true, micro: 'forms', activeNav: 'Formularios', label: 'Formulario de ingreso' },
  },
  {
    title: 'Horario',
    copy: 'Disponibilidad semanal, excepciones de fecha y zona horaria, en un solo lugar.',
    frame: 'hours' as const,
    frameProps: { compact: true, micro: 'hours', activeNav: 'Horario', label: 'Horario de la clínica' },
  },
  {
    title: 'Equipo y roles',
    copy: 'Acceso según el rol: Owner, Manager o Staff, sin compartirlo todo.',
    frame: 'team' as const,
    frameProps: { compact: true, micro: 'team', activeNav: 'Administración', label: 'Roles del equipo' },
  },
] as const
---

<BaseLayout title={title} description={description}>
  <section class="hero section">
    <div class="container hero__grid">
      <div class="hero__copy reveal">
        <p class="hero__eyebrow"><span class="status-dot status-dot--ok"></span> Para clínicas</p>
        <h1>Tu clínica ordenada, <span>de la cita al seguimiento.</span></h1>
        <p class="hero__sub">
          Agenda, formularios, fichas y notas clínicas en un solo flujo. Menos mensajes
          pendientes; más tiempo para atender.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={appSignupUrl}>Comenzar gratis</a>
          <a class="btn btn--ghost" href="#como-funciona">Ver cómo funciona</a>
        </div>
        <p class="hero__trust"><span>Plan gratuito</span><span>Configuración en minutos</span></p>
      </div>
      <div class="hero__visual reveal" data-reveal="scale">
        <div class="hero__halo" aria-hidden="true"></div>
        <ProductFrame variant="agenda" crop activeNav="Citas" label="Agenda semanal" />
        <div class="signal-card signal-card--intake" aria-hidden="true">
          <span class="signal-card__icon">✓</span>
          <span><strong>Ingreso completo</strong><small>Ana Rojas · hace 2 min</small></span>
        </div>
        <div class="signal-card signal-card--note" aria-hidden="true">
          <span class="status-dot status-dot--brand"></span>
          <span><strong>Nota lista</strong><small>Sesión anterior vinculada</small></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section problem-section">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Problema</p>
        <h2 class="section-title">Hoy la clínica se arma en el chat.</h2>
      </div>
      <div class="problem-grid">
        <article class="problem-card reveal">
          <div class="problem-card__scene" aria-hidden="true">
            <div class="pain-chat">
              <p class="pain-chat__meta">Chat · Interesado</p>
              <p class="pain-chat__bubble pain-chat__bubble--in">¿Tienes el jueves a las 5?</p>
              <p class="pain-chat__bubble pain-chat__bubble--out">Deja checo y te aviso</p>
              <p class="pain-chat__waiting">Sin respuesta · 2 h</p>
            </div>
          </div>
          <h3>Dijiste que revisabas y no contestaste</h3>
          <p>El interesado pregunta si hay hueco. Tú ibas a mirar el horario. El mensaje se quedó visto.</p>
        </article>
        <article class="problem-card reveal">
          <div class="problem-card__scene" aria-hidden="true">
            <div class="pain-ficha">
              <div class="pain-ficha__head">
                <strong>Sofía P.</strong>
                <span>Ficha</span>
              </div>
              <dl>
                <div><dt>Teléfono</dt><dd>· · ·</dd></div>
                <div><dt>Última visita</dt><dd class="is-empty">Sin historial</dd></div>
              </dl>
              <ul class="pain-ficha__visits">
                <li class="is-empty"><span>Visitas</span><span>Sin registros</span></li>
                <li class="is-empty"><span>Nota previa</span><span>No disponible</span></li>
              </ul>
            </div>
          </div>
          <h3>Cada visita empieza de cero</h3>
          <p>Lo de la sesión pasada no está en la ficha. Vuelves a preguntar lo que ya sabías.</p>
        </article>
        <article class="problem-card reveal">
          <div class="problem-card__scene" aria-hidden="true">
            <div class="pain-follow">
              <div class="pain-follow__bar">
                <span class="status-dot"></span>
                Sesión 6 · finalizada
              </div>
              <ul>
                <li><span class="status-dot status-dot--warn"></span> Sin próxima</li>
                <li><span class="status-dot status-dot--warn"></span> Plan no registrado</li>
              </ul>
            </div>
          </div>
          <h3>La sesión termina y el hilo se corta</h3>
          <p>No hay próxima cita, ni plan a la vista, ni recordatorio. El seguimiento vive en la cabeza.</p>
        </article>
      </div>
    </div>
  </section>

  <div class="problem-bridge" aria-label="Del problema al flujo">
    <div class="container problem-bridge__inner reveal">
      <span class="problem-bridge__line" aria-hidden="true"></span>
      <p><strong>Del mensaje pendiente al siguiente paso.</strong> El flujo empieza antes de la visita y deja la ficha preparada para después.</p>
    </div>
  </div>

  <section class="section setup-section" id="como-funciona">
    <div class="container">
      <div class="setup-intro reveal">
        <p class="section-label">Cómo funciona</p>
        <h2 class="section-title">Empezar no debería tomar una semana.</h2>
        <p class="section-lead">
          Horario, servicios y la primera cita. El resto del flujo ya está en el mismo sitio.
        </p>
        <div class="setup-intro__actions">
          <a class="btn btn--primary" href={appSignupUrl}>Comenzar gratis</a>
          <a class="btn btn--ghost" href="#recorrido">Ver el flujo de una visita</a>
        </div>
      </div>
      <div class="setup-grid">
        {
          setupSteps.map((step) => (
            <article class="setup-card reveal">
              <span class="setup-card__n">{step.n}</span>
              <div class="setup-card__frame">
                <ProductFrame variant={step.frame} {...step.frameProps} />
              </div>
              <h3>{step.title}</h3>
              <p>{step.line}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight capability-section">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Más que una agenda</p>
        <h2 class="section-title">Todo lo que sostiene la clínica, también está aquí.</h2>
        <p class="section-lead">Organiza el día, configura servicios, prepara formularios y define quién puede hacer qué.</p>
      </div>
      <div class="capability-bento" aria-label="Capacidades operativas de la clínica">
        <article class="capability-bento__panel reveal">
          <div class="capability-bento__visual">
            <ProductFrame variant="panel" compact micro="panel" activeNav="Panel principal" label="Panel principal" />
          </div>
          <div class="capability-bento__copy">
            <p class="capability-bento__eyebrow">Panel principal</p>
            <h3>Hoy, sin buscar en cinco lugares.</h3>
            <p>Citas de hoy, estados y acciones rápidas en la vista que abre el equipo.</p>
          </div>
        </article>
        <div class="capability-bento__tiles">
          {
            capabilityTiles.map((tile) => (
              <article class="capability-tile reveal">
                <div class="capability-tile__visual">
                  <ProductFrame variant={tile.frame} {...tile.frameProps} />
                </div>
                <div class="capability-tile__copy">
                  <h3>{tile.title}</h3>
                  <p>{tile.copy}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
      <a class="text-link capability-section__cta" href="/producto">Ver todas las capacidades</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="integrations-intro reveal">
        <div>
          <p class="section-label">Integraciones</p>
          <h2 class="section-title">Se conecta con lo que ya usas.</h2>
          <p class="section-lead">HabemusDandy mantiene las citas visibles en los calendarios que el equipo ya consulta.</p>
        </div>
        <a class="text-link" href="/producto#integraciones">Ver integraciones</a>
      </div>
      <div class="integrations" aria-label="Integraciones de calendario">
        <article class="integrations__card reveal">
          <span class="integration-icon" aria-hidden="true"><img src="/integrations/google-calendar.svg" alt="" width="40" height="40" /></span>
          <div>
            <h3>Google Calendar</h3>
            <p><span class="integration-status">Una vía</span> Tus citas → Google Calendar</p>
          </div>
        </article>
        <article class="integrations__card reveal">
          <span class="integration-icon" aria-hidden="true"><img src="/integrations/apple-calendar.svg" alt="" width="40" height="40" /></span>
          <div>
            <h3>Apple Calendar</h3>
            <p><span class="integration-status">Solo lectura</span> Enlace privado de suscripción</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tight pricing-home">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Precios</p>
        <h2 class="section-title">Empieza gratis. Crece con tu equipo.</h2>
        <p class="section-lead">Tres opciones claras, con precio por clínica en el plan Equipos.</p>
      </div>
      <div class="pricing-home__billing reveal">
        <BillingToggle controls="home-pricing-plans" />
      </div>
      <div class="pricing-teaser" id="home-pricing-plans" data-billing="monthly">
        <article class="pricing-card reveal">
          <p class="pricing-card__eyebrow">Para comenzar</p>
          <h3>Gratis</h3>
          <p class="pricing-card__price">$0</p>
          <ul>
            <li>Agenda semanal y citas</li>
            <li>Clientes y fichas</li>
            <li>Notas clínicas</li>
          </ul>
          <a class="btn btn--ghost" href={appSignupUrl}>Comenzar gratis</a>
        </article>
        <article class="pricing-card pricing-card--featured reveal">
          <span class="pricing-card__badge">Recomendado</span>
          <p class="pricing-card__eyebrow">Para el equipo</p>
          <h3>Equipos</h3>
          <p class="pricing-card__price" aria-live="polite">
            <strong data-billing-content="monthly">$249</strong>
            <strong data-billing-content="annual" hidden>$199</strong>
            <span>/ mes</span>
          </p>
          <p class="pricing-card__billing">
            <span data-billing-content="monthly">Pago mes a mes</span>
            <span data-billing-content="annual" hidden>$2,388 facturados al año · ahorras $600</span>
          </p>
          <ul>
            <li>Precio por clínica, no por persona</li>
            <li>Formularios de ingreso</li>
            <li>Equipo, roles e integraciones</li>
          </ul>
          <a class="btn btn--primary" href={appSignupUrl}>Elegir Equipos</a>
        </article>
        <article class="pricing-card pricing-card--dark reveal">
          <p class="pricing-card__eyebrow">Operaciones grandes</p>
          <h3>Empresas</h3>
          <p class="pricing-card__price">A medida</p>
          <ul>
            <li>Todo lo de Equipos</li>
            <li>Configuración acompañada</li>
            <li>Condiciones a tu medida</li>
          </ul>
          <a class="btn btn--text pricing-card__sales" href={salesContactUrl}>Contactar a ventas</a>
        </article>
      </div>
      <a class="text-link pricing-home__link" href="/precios">Comparar todos los planes</a>
    </div>
  </section>

  <section class="section journey-section" id="recorrido">
    <div class="container">
      <div class="journey-intro reveal">
        <div>
          <p class="section-label">Una cita, de principio a fin</p>
          <h2 class="section-title">El contexto avanza con cada visita.</h2>
        </div>
        <div>
          <p class="section-lead">No son módulos separados. Cada paso prepara el siguiente para que el equipo atienda sin reconstruir la historia.</p>
          <a class="text-link" href={appSignupUrl}>Comenzar gratis</a>
        </div>
      </div>
      <ClinicJourney />
    </div>
  </section>

  <Faq items={faqItems} showSignupLink />
  <Cta showFlow />
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .hero__grid {
    max-width: 100%;
    min-width: 0;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    max-width: 36rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 var(--space-4);
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    box-shadow: var(--shadow-card);
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.35rem, 5.4vw, 3.55rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  .hero h1 span {
    color: var(--color-ink);
  }

  .hero__sub {
    margin: var(--space-4) 0 0;
    max-width: 32rem;
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .hero__trust span::before {
    content: '\2713';
    margin-right: 0.4rem;
    color: var(--color-status-ok);
  }

  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    isolation: isolate;
  }

  .problem-bridge {
    padding-block: 0 clamp(1.25rem, 3vw, 2.5rem);
    background: color-mix(in srgb, var(--color-warm) 62%, transparent);
  }

  .problem-bridge__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: 52rem;
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    color: var(--color-muted);
    font-size: 0.96rem;
  }

  .problem-bridge__inner p {
    margin: 0;
  }

  .problem-bridge__inner strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .problem-bridge__line {
    width: 2.5rem;
    height: 2px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--color-brand);
  }

  .hero__visual :global(.product-frame) {
    position: relative;
    z-index: 2;
    transform: perspective(1400px) rotateY(-5deg) rotateX(1.5deg);
    transform-origin: left center;
  }

  .hero__halo {
    position: absolute;
    inset: 10% 8% -12%;
    z-index: -1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    filter: blur(55px);
  }

  .signal-card {
    position: absolute;
    z-index: 3;
    display: none;
    align-items: center;
    gap: 0.7rem;
    min-width: 12.5rem;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    box-shadow: var(--shadow-card-hover);
    backdrop-filter: blur(12px);
  }

  :global(.js) .hero__visual:not(.is-visible) .signal-card {
    opacity: 0;
    transform: translateY(0.75rem);
  }

  .hero__visual.is-visible .signal-card {
    animation:
      signal-enter 640ms cubic-bezier(0.16, 1, 0.3, 1) both,
      signal-float 7s ease-in-out 900ms infinite;
  }

  .signal-card--intake {
    top: 14%;
    left: -1.1rem;
  }

  .signal-card--note {
    right: -0.6rem;
    bottom: 12%;
  }

  .hero__visual.is-visible .signal-card--intake {
    animation-delay: 180ms, 1080ms;
  }

  .hero__visual.is-visible .signal-card--note {
    animation-delay: 360ms, 1260ms;
  }

  .signal-card__icon {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-status-ok) 14%, var(--color-surface));
    color: var(--color-status-ok);
    font-size: 0.8rem;
  }

  .signal-card > span:last-child {
    display: grid;
  }

  .signal-card strong {
    font-size: 0.78rem;
    font-weight: 600;
  }

  .signal-card small {
    color: var(--color-muted);
    font-size: 0.67rem;
  }

  @keyframes signal-enter {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes signal-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .problem-grid,
  .setup-grid,
  .integrations,
  .pricing-teaser,
  .capability-bento {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .problem-section {
    padding-top: clamp(4rem, 8vw, 5.5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
    background: color-mix(in srgb, var(--color-warm) 62%, transparent);
  }

  .problem-card,
  .setup-card,
  .integrations__card,
  .pricing-card {
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .problem-card,
  .setup-card {
    display: grid;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .problem-card {
    grid-template-rows: 11rem minmax(2.7em, auto) 1fr;
    gap: var(--space-4);
    transition: transform var(--motion-base), box-shadow var(--motion-base);
  }

  .problem-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .problem-card__scene,
  .setup-card__frame {
    height: 11rem;
    min-height: 11rem;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .problem-card__scene {
    display: grid;
    align-content: center;
    padding: 0.85rem;
    background: var(--color-frame);
  }

  .pain-chat,
  .pain-ficha,
  .pain-follow {
    height: 100%;
  }

  .pain-chat {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }

  .pain-chat__meta {
    margin: 0 0 0.25rem;
    color: var(--color-muted);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pain-chat__bubble {
    max-width: 92%;
    margin: 0;
    padding: 0.55rem 0.7rem;
    border-radius: 0.85rem;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .pain-chat__bubble--in {
    justify-self: start;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .pain-chat__bubble--out {
    justify-self: end;
    background: color-mix(in srgb, var(--color-brand) 12%, var(--color-surface));
  }

  .pain-chat__waiting {
    margin: 0.35rem 0 0;
    justify-self: start;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    opacity: 0.85;
  }

  .pain-ficha {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    padding: 0.2rem;
  }

  .pain-ficha__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .pain-ficha__head strong {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .pain-ficha__head span {
    color: var(--color-muted);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pain-ficha dl {
    margin: 0;
    display: grid;
    gap: 0.35rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .pain-ficha dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.78rem;
  }

  .pain-ficha dt {
    color: var(--color-muted);
  }

