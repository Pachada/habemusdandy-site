---
import { appSignupUrl } from '../config/site'

interface FaqItem {
  question: string
  answer: string
  answerHtml?: string
}

interface Props {
  items: readonly FaqItem[]
  title?: string
  label?: string
  intro?: string
  showSignupLink?: boolean
}

const {
  items,
  title = 'Preguntas frecuentes',
  label = 'FAQ',
  intro = 'Respuestas cortas sobre agenda, pacientes, datos y cómo empezar.',
  showSignupLink = false,
} = Astro.props
---

<section class="faq section">
  <div class="container faq__layout">
    <div class="faq__intro reveal">
      <p class="section-label">{label}</p>
      <h2 class="section-title">{title}</h2>
      <p class="faq__lead">{intro}</p>
      {
        showSignupLink && (
          <a class="text-link" href={appSignupUrl}>Comenzar gratis</a>
        )
      }
    </div>
    <div class="faq__list" data-faq>
      {
        items.map((item, index) => (
          <div class="faq__item reveal">
            <h3>
              <button
                class="faq__trigger"
                type="button"
                aria-expanded={index === 0 ? 'true' : 'false'}
                aria-controls={`faq-panel-${index}`}
                id={`faq-trigger-${index}`}
              >
                <span>{item.question}</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </button>
            </h3>
            <div
              class:list={['faq__panel', index === 0 && 'is-open']}
              id={`faq-panel-${index}`}
              role="region"
              aria-labelledby={`faq-trigger-${index}`}
              aria-hidden={index === 0 ? undefined : 'true'}
              inert={index !== 0}
            >
              <div class="faq__panel-inner">
                {item.answerHtml ? (
                  <p set:html={item.answerHtml} />
                ) : (
                  <p>{item.answer}</p>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-faq]').forEach((root) => {
    root.querySelectorAll('.faq__trigger').forEach((button) => {
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true'
        const panelId = button.getAttribute('aria-controls')
        const panel = panelId ? document.getElementById(panelId) : null
        button.setAttribute('aria-expanded', String(!expanded))
        if (!panel) return

        panel.classList.toggle('is-open', !expanded)
        panel.setAttribute('aria-hidden', String(expanded))
        if (expanded) panel.setAttribute('inert', '')
        else panel.removeAttribute('inert')
      })
    })
  })
</script>

<style>
  .faq__layout {
    display: grid;
    gap: var(--space-6);
  }

  .faq__intro {
    max-width: 28rem;
  }

  .faq__lead {
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .faq__intro :global(.text-link) {
    margin-top: var(--space-4);
  }

  .faq__list {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .faq__item {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: box-shadow var(--motion-base), transform var(--motion-base);
  }

  .faq__item:has(.faq__trigger[aria-expanded='true']) {
    box-shadow: 0 14px 38px rgba(17, 40, 53, 0.08);
  }

  .faq__item:hover {
    transform: translateY(-1px);
  }

  .faq__item h3 {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  .faq__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    font-size: 1.02rem;
  }

  .faq__icon {
    width: 0.65rem;
    height: 0.65rem;
    border-right: 2px solid var(--color-muted);
    border-bottom: 2px solid var(--color-muted);
    transform: rotate(45deg);
    transition: transform var(--motion-fast);
    flex-shrink: 0;
  }

  .faq__trigger[aria-expanded='true'] .faq__icon {
    transform: rotate(225deg);
  }

  .faq__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq__panel.is-open {
    grid-template-rows: 1fr;
  }

  .faq__panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  .faq__panel-inner p {
    margin: 0;
    padding: 0 var(--space-5) var(--space-5);
    max-width: 48rem;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .faq__panel a {
    color: var(--color-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .faq__panel a:hover {
    text-decoration: underline;
  }

  @media (min-width: 900px) {
    .faq__layout {
      grid-template-columns: minmax(14rem, 0.85fr) minmax(0, 1.35fr);
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: start;
    }

    .faq__intro {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__panel {
      transition: none;
    }
  }
</style>
